{
  "manifest_version": 3,
  "name": "RGAA Audit",
  "version": "0.4.0",
  "description": "Pré-audit d’accessibilité RGAA 4.1.2 et vérification manuelle guidée — Le Singe Du Numérique",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "panel/panel.html",
    "default_title": "RGAA Audit — Le Singe Du Numérique",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "guide/guide.html"
  },
  "minimum_chrome_version": "116"
}
